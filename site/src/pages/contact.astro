---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <h1>Contact Us</h1>
  <form class="form">
    <input type="text" id="fname" name="fname" placeholder="Name" />
    <input type="email" id="email" name="email" placeholder="Email" />
    <textarea id="messsage" name="messsage" placeholder="Message"></textarea>

    <input class="btn" type="submit" value="Submit" />
  </form>
</Layout>

<style>
  .form {
    color: var(--accent);
    display: flex;
    align-items: center;
    flex-direction: column;
    margin: 32px;
    gap: 16px;
  }

  h1 {
    font-size: 60px;
    font-weight: 700;
    margin: 0;
    font-family: "Space Mono", monospace;
    color: var(--accent);
    text-align: center;
  }

  input,
  textarea {
    width: 100%;
    max-width: 400px;
    border: 2px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    height: 50px;
    font-size: 16px;
    padding: 16px;
    color: var(--accent);
    font-family: "Space Mono", monospace;
  }

  textarea {
    height: 200px;
  }

  .btn {
    font-family: "Space Mono", monospace;
    font-size: 20px;
    cursor: pointer;
    padding: 5px 20px;
    border: none;
    color: white;
    border-radius: 4px;
    font-size: 20px;
    text-decoration: none;

    --color: #3c6927; /* the color*/

    box-shadow: 0 0 0 0.1em inset var(--color);
    --gradient: linear-gradient(var(--color) 0 0) no-repeat;
    background:
      var(--gradient) calc(var(--pos, 0%) - 100%) 0%,
      var(--gradient) calc(200% - var(--pos, 0%)) 0%,
      var(--gradient) calc(var(--pos, 0%) - 100%) 100%,
      var(--gradient) calc(200% - var(--pos, 0%)) 100%;
    background-size: 50.5% calc(var(--pos, 0%) / 2 + 0.5%);
    outline-offset: 0.1em;
    transition:
      background-size 0.2s,
      background-position 0s 0.2s;
  }
  .btn:hover {
    --pos: 100%;
    transition:
      background-position 0.2s,
      background-size 0s;
  }
  .btn:active {
    box-shadow: 0 0 9e9Q inset #0009;
    background-color: var(--color);
    color: #fff;
  }

  .email {
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--accent);
    font-size: 32px;
  }
</style>
