---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <script type="text/javascript">
  var Email = { send: function (a) { return new Promise(function (n, e) { a.nocache = Math.floor(1e6 * Math.random() + 1), a.Action = "Send"; var t = JSON.stringify(a); Email.ajaxPost("https://smtpjs.com/v3/smtpjs.aspx?", t, function (e) { n(e) }) }) }, ajaxPost: function (e, n, t) { var a = Email.createCORSRequest("POST", e); a.setRequestHeader("Content-type", "application/x-www-form-urlencoded"), a.onload = function () { var e = a.responseText; null != t && t(e) }, a.send(n) }, ajax: function (e, n) { var t = Email.createCORSRequest("GET", e); t.onload = function () { var e = t.responseText; null != n && n(e) }, t.send() }, createCORSRequest: function (e, n) { var t = new XMLHttpRequest; return "withCredentials" in t ? t.open(e, n, !0) : "undefined" != typeof XDomainRequest ? (t = new XDomainRequest).open(e, n) : t = null, t } };
  </script>
   <script type="text/javascript">
    function sendEmail() {
      Email.send({
          SecureToken : "fb6b6d14-72e4-427f-b78f-9e058bc64b4d",
          To : 'ninjawashyper152@gmail.com',
          From : "karthik.duvvuri08@gmail.com",
          Subject : "Contact Information",
          Body : getName()
      }).then(message =>{
          if(message !== "OK"){
            document.getElementById("errorMessage").innerHTML = message;
            document.getElementById("error").toggleAttribute("hidden", false);
          }
          else{
            location.reload();
          }
        }
      );
    }

    function getName() {
      let getTextArea = document.getElementById("txtArea");
      let textMessage = " Message: " + getTextArea.value;
      let email = " Email: " + document.getElementById("email").value
      let firstName = " Name: " + document.getElementById("fname").value

      return firstName + email + textMessage
    }

  </script>
  <h1>Contact Us</h1>
  <form method="post" class="form" onsubmit="sendEmail()">
    <div hidden id="error">
      <p id="errorMessage"></p>
    </div>
    <input type="text" id="fname" name="fname" placeholder="Name" />
    <input type="email" id="email" name="email" placeholder="Email" />
    <textarea id="txtArea" name="messsage" placeholder="Message"></textarea>

    <input class="btn" type="submit" value="Send Mail"/>
  </form>
</Layout>

<style>
  #error{
    background-color:rgb(255, 100, 100);
    max-width: 400px;
    width: 100%;
    border-radius: 4px;
  }

  #errorMessage{
    text-align: center;
    padding: 5px;
    font-size: 16px;
    color: white;
    font-weight: #cccccc;
    font-family: "Space Mono", monospace;
  }

  .form {
    color: var(--accent);
    display: flex;
    align-items: center;
    flex-direction: column;
    margin: 32px;
    gap: 16px;
  }

  h1 {
    font-size: 60px;
    font-weight: 700;
    margin: 0;
    font-family: "Space Mono", monospace;
    color: var(--accent);
    text-align: center;
  }

  input,
  textarea {
    width: 100%;
    max-width: 400px;
    border: 2px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    height: 50px;
    font-size: 16px;
    padding: 16px;
    color: var(--accent);
    font-family: "Space Mono", monospace;
  }

  textarea {
    height: 200px;
  }

  .btn {
    font-family: "Space Mono", monospace;
    font-size: 20px;
    cursor: pointer;
    padding: 5px 20px;
    border: none;
    color: white;
    border-radius: 4px;
    font-size: 20px;
    text-decoration: none;

    --color: #3c6927; /* the color*/

    box-shadow: 0 0 0 0.1em inset var(--color);
    --gradient: linear-gradient(var(--color) 0 0) no-repeat;
    background:
      var(--gradient) calc(var(--pos, 0%) - 100%) 0%,
      var(--gradient) calc(200% - var(--pos, 0%)) 0%,
      var(--gradient) calc(var(--pos, 0%) - 100%) 100%,
      var(--gradient) calc(200% - var(--pos, 0%)) 100%;
    background-size: 50.5% calc(var(--pos, 0%) / 2 + 0.5%);
    outline-offset: 0.1em;
    transition:
      background-size 0.2s,
      background-position 0s 0.2s;
  }
  .btn:hover {
    --pos: 100%;
    transition:
      background-position 0.2s,
      background-size 0s;
  }
  .btn:active {
    box-shadow: 0 0 9e9Q inset #0009;
    background-color: var(--color);
    color: #fff;
  }

  .email {
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--accent);
    font-size: 32px;
  }
</style>
