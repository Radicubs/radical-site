---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sponsors">
  <div class="container">
    <h2>Corporate Sponsors</h2>
    <hr />
    <div class="corporate-sponsors">
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
      <img src="cat.jpg" alt="temp" width="300" />
    </div>
    <h2>Individual Sponsors</h2>
    <hr />
    <ul class="individual-sponsors">
      <li>Sule Family</li>
      <li>Ganapathineedi Family</li>
      <li>Baumel Family</li>
    </ul>
    <div class="become-sponsor">
      <a class="link" href="/contact">Become a Sponsor</a>
    </div>
  </div>
</Layout>
<style>
  .container {
    max-width: 1000px;
    margin: auto;
  }

  hr {
    border: 2px solid var(--accent);
    max-width: 100px;
    margin-left: 0;
    margin-bottom: 20px;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  .corporate-sponsors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    grid-gap: 20px;
  }

  .corporate-sponsors img {
    width: 100%;
    height: auto;
  }

  .individual-sponsors {
    font-size: 20px;
  }

  .become-sponsor {
    display: flex;
    justify-content: center;
    padding: 20px 40px 40px 40px;
  }

  .link {
    font-family: "Space Mono", monospace;
    font-size: 20px;
    cursor: pointer;
    padding: 5px 20px;
    border: none;
    color: white;
    border-radius: 20px;
    font-size: 20px;
    text-decoration: none;

    --color: #3c6927; /* the color*/

    box-shadow: 0 0 0 0.1em inset var(--color);
    --gradient: linear-gradient(var(--color) 0 0) no-repeat;
    background:
      var(--gradient) calc(var(--pos, 0%) - 100%) 0%,
      var(--gradient) calc(200% - var(--pos, 0%)) 0%,
      var(--gradient) calc(var(--pos, 0%) - 100%) 100%,
      var(--gradient) calc(200% - var(--pos, 0%)) 100%;
    background-size: 50.5% calc(var(--pos, 0%) / 2 + 0.5%);
    outline-offset: 0.1em;
    transition:
      background-size 0.2s,
      background-position 0s 0.2s;
  }
  .link:hover {
    --pos: 100%;
    transition:
      background-position 0.2s,
      background-size 0s;
  }
  .link:active {
    box-shadow: 0 0 9e9Q inset #0009;
    background-color: var(--color);
    color: #fff;
  }
</style>
