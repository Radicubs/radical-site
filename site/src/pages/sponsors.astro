---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sponsors">
  <header>
    <div class="content">
      <h1>Sponsors</h1>
      <div>
        <button onclick="window.location.href = 'https://w3docs.com'; "> Corporate Sponsors</button>
        <button onclick="window.location.href = 'https://w3docs.com'; " style="--c:#3C6927" > Become a Sponsors</button>
        <button onclick="window.location.href = 'https://w3docs.com';" style="--c:#3C6927"> Indiviudal Sponsors</button>
      </div>
    </div>
  </header>
  <style>
    header {
      color: white;
      height: 100vh;
      padding: 32px;
      gap: 32px;
      background-color: black;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .content {
      width: 50%;
    }

    h1 {
      font-size: 64px;
      font-weight: 700;
      margin-bottom: 0px;
      font-family: "Space Mono", monospace;
      color: var(--accent);
    }

    button {
      font-family: "Space Mono", monospace;
      font-size: 3.5rem;
      cursor: pointer;
      padding: .1em .6em;
      border: none;
      color:white;
      border-radius: 25px;
      font-size: 20px;
    }
    button {
      --c:  #3C6927; /* the color*/
      
      box-shadow: 0 0 0 .1em inset var(--c); 
      --_g: linear-gradient(var(--c) 0 0) no-repeat;
      background: 
        var(--_g) calc(var(--_p,0%) - 100%) 0%,
        var(--_g) calc(200% - var(--_p,0%)) 0%,
        var(--_g) calc(var(--_p,0%) - 100%) 100%,
        var(--_g) calc(200% - var(--_p,0%)) 100%;
      background-size: 50.5% calc(var(--_p,0%)/2 + .5%);
      outline-offset: .1em;
      transition: background-size .2s, background-position 0s .2s;
    }
    button:hover {
      --_p: 100%;
      transition: background-position .2s, background-size 0s;
    }
    button:active {
      box-shadow: 0 0 9e9q inset #0009; 
      background-color: var(--c);
      color: #fff;
    }
  </style>
</Layout>
