---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Welcome to Astro.">
  <header>
    <div class="content">
      <h1>Sponsors</h1>
      <div class="socials">
        <button onclick="window.location.href = 'https://w3docs.com'; "> Corporate Sponsers</button>
        <button onclick="window.location.href = 'https://w3docs.com'; "> Become a Sponsors</button>
        <button onclick="window.location.href = 'https://w3docs.com';"> Indiviudal Sponsors</button>
      </div>
    </div>
  </header>
  <footer>
    <div>The Radicubs Robotics Team is recognized as a non-profit organization under a 501(c)(3).</div>
  </footer>
  <style>
    header {
      color: white;
      height: 100vh;
      padding: 32px;
      gap: 32px;
      background-color: black;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .content {
      width: 40%;
    }

    h1 {
      font-size: 64px;
      font-weight: 700;
      margin-bottom: 0px;
      font-family: "Space Mono", monospace;
      color: var(--accent);
    }

    .subheading {
      color: lightgray;
      font-size: 20px;
    }

    .socials {
      margin-top: 32px;
      font-size: 32px;
      display: flex;
      gap: 8px;
    }

    .socials > a {
      color: var(--accent);
    }

    footer {
      width: 100%;
      text-align: center;
      color: white;
      position: fixed;
      bottom: 16px;
    }
  </style>
</Layout>
