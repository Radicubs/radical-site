<style>
  .sponsor-text{
    align-self: center;
  }

  .image-wrapper > img {
    margin-left:15px;
    margin-right:15px;
  }

  .image-wrapper{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .header {
    margin-left: 120px;
    margin-right: 120px;
  }

  .sponsors {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  hr {
    border: 2px solid var(--accent);
    width: 100%;
    max-width: 400px;
  }

  .content {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  h1 {
    font-size: 64px;
    font-weight: 700;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  .btn-wrapper{
    align-self: center;
  }
  .btn {
    font-family: "Space Mono", monospace;
    font-size: 3.5rem;
    cursor: pointer;
    padding: 0.1em 0.6em;
    border: none;
    color: white;
    border-radius: 20px;
    font-size: 20px;
    text-decoration:none;
    
    --color: #3c6927; /* the color*/

    box-shadow: 0 0 0 0.1em inset var(--color);
    --gradient: linear-gradient(var(--color) 0 0) no-repeat;
    background:
      var(--gradient) calc(var(--pos, 0%) - 100%) 0%,
      var(--gradient) calc(200% - var(--pos, 0%)) 0%,
      var(--gradient) calc(var(--pos, 0%) - 100%) 100%,
      var(--gradient) calc(200% - var(--pos, 0%)) 100%;
    background-size: 50.5% calc(var(--pos, 0%) / 2 + 0.5%);
    outline-offset: 0.1em;
    transition:
      background-size 0.2s,
      background-position 0s 0.2s;
  }
  .btn:hover {
    --pos: 100%;
    transition:
      background-position 0.2s,
      background-size 0s;
  }
  .btn:active {
    box-shadow: 0 0 9e9Q inset #0009;
    background-color: var(--color);
    color: #fff;
  }


</style>
