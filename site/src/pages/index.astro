---
import Layout from "../layouts/Layout.astro";
import Spotlight from "../components/Spotlight.astro";
import fetchApi from "../lib/strapi";

const home = await fetchApi({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
}) as any;

---

<Layout title="Radicubs">
  <header>
    <div class="content">
      <h1>Radicubs</h1>
      <div class="subheading">
        We are an independent robotics team from Frisco, Texas. Our purpose is to provide a free outlet for students of
        Frisco, Texas to pursue their interests in STEM and finance through the FIRST Robotics Competition (FRC).
      </div>
      <div class="socials">
        <a href="https://instagram.com/theradicubs"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://twitter.com/theradicubs"><i class="fa-brands fa-twitter"></i></a>
        <a href="https://www.tiktok.com/@theradicubs"><i class="fa-brands fa-tiktok"></i></a>
        <a href="https://youtube.com/channel/UCNuzQPRdm0OBcJaWgX8z6eQ"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>
    <div class="media">
      <img src={import.meta.env.STRAPI_URL + home.attributes.heroImage.data.attributes.url} alt="Radicubs Logo" width="400" height="400" />
    </div>
  </header>
  <Spotlight>
  </Spotlight>
</Layout>

<style is:global>
  #root {
    height: 100%;
  }
</style>

<style>
  header {
    color: white;
    gap: 32px;
    padding-top:140px;
    padding-bottom: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content {
    width: 40%;
  }

  .subheading {
    color: lightgray;
    font-size: 20px;
  }

  .socials {
    margin-top: 32px;
    font-size: 32px;
    display: flex;
    gap: 8px;
  }

  .socials > a {
    color: var(--accent);
  }

  /* mobile no .media */
  @media (max-width: 768px) {
    .content {
      width: 100%;
    }

    .media {
      display: none;
    }
  }
</style>
