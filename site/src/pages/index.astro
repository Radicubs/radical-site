---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Welcome to Astro.">
  <header>
    <h1>Radicubs</h1>
    <div class="subheading">We are an independent robotics team from Frisco, Texas.</div>
  </header>
</Layout>

<style>
  header {
    color: white;
    height: 600px;
    padding: 32px;
    background-color: black;
  }

  h1 {
    font-size: 64px;
    font-weight: 700;
    margin-top: 200px;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: #8efc5e;
  }

  .subheading {
    color: lightgray;
    font-size: 20px;
  }
</style>
