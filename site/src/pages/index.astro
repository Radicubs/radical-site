---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <header>
    <div class="content">
      <h1>Radicubs</h1>
      <div class="subheading">
        We are an independent robotics team from Frisco, Texas. Our purpose is to provide a free outlet for students of
        Frisco, Texas to pursue their interests in STEM and finance through the FIRST Robotics Competition (FRC).
      </div>
      <div class="socials">
        <a href="https://instagram.com/theradicubs"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://twitter.com/theradicubs"><i class="fa-brands fa-twitter"></i></a>
        <a href="https://www.tiktok.com/@theradicubs"><i class="fa-brands fa-tiktok"></i></a>
        <a href="https://youtube.com/channel/UCNuzQPRdm0OBcJaWgX8z6eQ"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>
    <div class="media">
      <img
        src="https://i.pinimg.com/originals/48/c9/52/48c9522aaa31a27582216bec737e92ce.gif"
        alt="Radicubs Logo"
        width="400"
        height="400"
      />
    </div>
  </header>
  <style>
    header {
      color: white;
      height: 100%;
      padding: 32px;
      gap: 32px;
      background-color: black;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .content {
      width: 40%;
    }

    h1 {
      font-size: 64px;
      font-weight: 700;
      margin: 0;
      font-family: "Space Mono", monospace;
      color: var(--accent);
    }

    .subheading {
      color: lightgray;
      font-size: 20px;
    }

    .socials {
      margin-top: 32px;
      font-size: 32px;
      display: flex;
      gap: 8px;
    }

    .socials > a {
      color: var(--accent);
    }
  </style>
</Layout>
