---
import Layout from "../layouts/Layout.astro";
import TeamMember from "../components/TeamMember.astro";

import type { ApiTeamMemberTeamMember } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const teamMembers = await fetchApi<ApiTeamMemberTeamMember[]>({
  endpoint: "team-members", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const teamMembersByYear = teamMembers.reduce((acc, member) => {
  const year = member.attributes.year - 2018;
  if (!acc[year]) acc[year] = [];
  acc[year].push(member);
  return acc;
}, []);
---

<Layout title="Meet the Team">
  <div class="container">
    {
      teamMembersByYear.map((members, year) => (
        <details>
          <summary>
            {year + 2018} - {year + 2019}
          </summary>
          <div class="team-members">
            {members.map(member => (
              <TeamMember
                name={member.attributes.name}
                role={member.attributes.role}
                photo_url={import.meta.env.STRAPI_URL + member.attributes.avatar.data.attributes.url}
              />
            ))}
          </div>
        </details>
      ))
    }
  </div>
</Layout>

<style>
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  details {
    background-color: #181818;
    border-radius: 5px;
  }

  summary {
    color: var(--accent);
    font-size: 20px;
    padding: 10px;
    font-weight: bold;
    border-radius: 5px;
    border: 1px solid var(--accent);
  }

  .team-members {
    display: flex;
    padding: 20px;
    flex-wrap: wrap;
    gap: 20px;
  }
</style>
