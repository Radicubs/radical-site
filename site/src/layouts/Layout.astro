---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Radicubs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/03998fe36f.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <nav class="navbar">
      <a href="/">Home</a>
      <a href="/team">Team</a>
      <a href="/sponsors">Sponsors</a>
      <a href="/spotlight">Spotlight</a>
      <a href="/contact">Contact</a>
      <a href="/blog">Blog</a>
      <a href="https://www.paypal.com/paypalme/radicubs">Donate</a>
    </nav>
    <div id="root">
      <slot />
    </div>
    <!-- ❗ DONT YOU DARE FUCKING UNCOMMENT THIS I WILL FIND YOU ❗ -->
    <!-- <footer>
      <div>The Radicubs Robotics Team is recognized as a non-profit organization under a 501(c)(3).</div>
    </footer> -->
    <style is:global>
      h1 {
        font-size: 64px;
        font-weight: 700;
        margin: 0;
        font-family: "Space Mono", monospace;
        color: var(--accent);
      }

      h2 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 0px;
        font-family: "Space Mono", monospace;
        color: var(--accent);
      }
      :root {
        --accent: #8efc5e;
        --accent-gradient: linear-gradient(90deg, #8efc5e 0%, #03a9f4 100%);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        background-color: rgb(30, 30, 30);
      }

      html {
        font-family: Inter, sans-serif;
        color: white;
      }

      body {
        margin: 0;
      }

      #root {
        width: 100%;
        height: 100%;
      }

      code {
        font-family:
          Menlo,
          Monaco,
          Lucida Console,
          Liberation Mono,
          DejaVu Sans Mono,
          Bitstream Vera Sans Mono,
          Courier New,
          monospace;
      }
      .navbar {
        top: 0;
        z-index: 1;
        position: fixed;
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 20px;
        gap: 20px;
        background-color: #181818;
        border-bottom: 1px solid #828282;
      }

      .navbar > a {
        color: white;
        text-decoration: none;
      }
      .navbar > a:hover {
        text-decoration: underline;
      }
      footer {
        width: 100%;
        text-align: center;
        color: white;
      }

      @keyframes details-show {
        0% {
          opacity: 0;
          transform: var(--details-translate, translateY(-0.5em));
        }
      }

      details[open] > :not(summary) {
        animation: details-show 0.15s ease-in-out;
      }

      details > summary {
        cursor: pointer;
      }
    </style>
  </body>
</html>
