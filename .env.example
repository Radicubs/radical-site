DONATE_URL=
CONTACT_API_URL=
CONTACT_EMAIL=
# Public site key for the same Turnstile widget whose secret the contact service uses.
# Add each tested Vercel hostname to that widget's Cloudflare Hostname Management.
TURNSTILE_SITE_KEY=
TBA_API_KEY=
RADICUBS_HOME_FILM=
RADICUBS_HOME_FILM_POSTER=

# Payload CMS (editor at /admin), backed by Supabase
# Supabase → Connect → Session pooler (port 5432). Copy the exact host and username.
# Use this IPv4-compatible connection for local development and Vercel: the build
# runs migrations through DATABASE_URL, so it needs a session-compatible connection.
# Direct db.<project-ref>.supabase.co URLs require IPv6 or the paid IPv4 add-on.
# For verified TLS, append ?sslmode=verify-full&sslrootcert=cms/certs/supabase-ca.crt
DATABASE_URL=
# Any long random string; `openssl rand -hex 32`
PAYLOAD_SECRET=

# Supabase Storage (S3 connection). Project Settings → Storage → S3 access keys.
# Leave S3_BUCKET empty to keep uploads in ./media during local development.
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket. Visitors see files at <site>/media/<file>, which is forwarded here.
MEDIA_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# Supabase Auth, for "Sign in with Google" on /admin (Project Settings → API Keys)
# Google login stays disabled unless explicitly set to true before building.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
