---
import type { ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

interface Props {
  title: string;
}

const { title } = Astro.props;

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Radicubs | {title}</title>
    <meta name="site_name" content="radicubs.com" />
    <meta name="title" content={`Radicubs | ${title}`} />
    <meta name="description" content={home.attributes.description} />
    <meta name="theme-color" content="#8efc5e" />
    <meta name="image" content={import.meta.env.STRAPI_URL + home.attributes.image.data.attributes.url} />
    <meta name="keywords" content={home.attributes.keywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://kit.fontawesome.com/03998fe36f.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <nav class="navbar">
      <a href="/">Home</a>
      <a href="/team">Team</a>
      <a href="/sponsors">Sponsors</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
      <a href="https://www.paypal.com/paypalme/radicubs">Donate</a>
    </nav>
    <div id="root">
      <slot />
    </div>
    <!-- ❗ DONT YOU DARE FUCKING UNCOMMENT THIS I WILL FIND YOU ❗ -->
    <!-- <footer>
      <div>The Radicubs Robotics Team is recognized as a non-profit organization under a 501(c)(3).</div>
    </footer> -->
    <style is:global>
      h1 {
        font-size: 64px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 10px;
        font-family: "Space Mono", monospace;
        color: var(--accent);
      }

      :root {
        --primary: #101215;
        --secondary: #1b1d23;
        --tertiary: #2c303a;

        --accent: #8efc5e;
        --accent-dark: green;
        --accent-gradient: linear-gradient(90deg, #8efc5e 0%, #2c8c03 100%);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        background-color: var(--primary);
      }

      html {
        font-family: Inter, sans-serif;
        color: white;
      }

      body {
        margin: 0;
      }

      #root {
        width: 100%;
        height: 100%;
        padding-top: 58px;
      }

      code {
        font-family:
          Menlo,
          Monaco,
          Lucida Console,
          Liberation Mono,
          DejaVu Sans Mono,
          Bitstream Vera Sans Mono,
          Courier New,
          monospace;
      }
      .navbar {
        top: 0;
        z-index: 1;
        position: fixed;
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 20px;
        gap: 20px;
        background-color: var(--secondary);
      }

      .navbar > a {
        color: white;
        text-decoration: none;
      }
      .navbar > a:hover {
        text-decoration: underline;
      }
      footer {
        width: 100%;
        text-align: center;
        color: white;
      }

      @keyframes details-show {
        0% {
          opacity: 0;
          transform: var(--details-translate, translateY(-0.5em));
        }
      }

      details[open] > :not(summary) {
        animation: details-show 0.15s ease-in-out;
      }

      details > summary {
        cursor: pointer;
      }
    </style>
  </body>
</html>
