---
import Nav from "../components/Nav.astro";
import type { ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

interface Props {
  title: string;
}

const { title } = Astro.props;

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Radicubs | {title}</title>
    <meta name="og:site_name" content="radicubs.com" />
    <meta name="title" content={`Radicubs | ${title}`} />
    <meta name="description" content={home.attributes.description} />
    <meta name="theme-color" content="#8efc5e" />
    <meta name="og:image" content={import.meta.env.STRAPI_URL + home.attributes.image.data.attributes.url} />
    <meta name="keywords" content={home.attributes.keywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://kit.fontawesome.com/03998fe36f.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <Nav />
    <div id="root">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  h1 {
    font-size: 64px;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 10px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  :root {
    --primary: #101215;
    --secondary: #1b1d23;
    --tertiary: #2c303a;

    --accent: #8efc5e;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    background-color: var(--primary);
  }

  html {
    font-family: Inter, sans-serif;
    color: white;
  }

  body {
    margin: 0;
  }

  #root {
    width: 100%;
    height: 100%;
    padding-top: 58px;
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>
