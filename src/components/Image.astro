---
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt?: string;
  id?: string;
  class?: string;
  width?: string | number;
  height?: string | number;
  format?: "webp" | "jpg" | "png";
}

let { src, alt, width, height, format, ...rest } = Astro.props;

let url = new URL(src, import.meta.env.STRAPI_URL);
---

<Image src={url.toString()} alt={alt} width={width} height={height} {...rest} />
