---
import type { ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";
import Link from "./Link.astro";

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<nav>
  <i id="burger" class="fa-solid fa-bars"></i>
  <div id="links" class="links">
    <Link href="/">Home</Link>
    <Link href="/team">Team</Link>
    <Link href="/sponsors">Sponsors</Link>
    <Link href="/gallery">Gallery</Link>
    <Link href="/blog">Blog</Link>
    <Link href="/contact">Contact</Link>
    <Link href={home.attributes.applicationUrl}>Apply</Link>
    <Link href={import.meta.env.DONATE_URL}>Donate</Link>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: var(--secondary);
    z-index: 100;
    padding: 20px;
    box-sizing: border-box;
    box-shadow: 0 0 16px rgba(0, 0, 0, 0.5);
  }

  nav #burger {
    display: none;
  }

  nav .links {
    max-width: 1000px;
    margin: auto;
    display: flex;
    justify-content: center;
    gap: 20px;
  }

  @media (max-width: 768px) {
    nav #burger {
      display: block;
      cursor: pointer;
    }

    nav .links {
      flex-direction: column;
      gap: 10px;
      align-items: center;
      justify-content: start;
      overflow: hidden;
      max-height: 0;
      transition: max-height 1s ease-in-out;
      font-size: 20px;
    }

    nav .links.active {
      max-height: var(--height, fit-content);
    }
  }
</style>

<script>
  const $burger = document.getElementById("burger");
  const $links = document.getElementById("links");

  $burger.addEventListener("click", () => $links.classList.toggle("active"));
  $links.style.setProperty("--height", `${$links.scrollHeight}px`);
</script>
