---
import { slugify } from "../lib/blog";
import type { ApiBlogPostBlogPost } from "../lib/contentTypes";
import Image from "./Image.astro";

const youtubeVideoRegex =
  /^.*(?:(?:youtu\.be\/|v\/|vi\/|u\/\w\/|embed\/|shorts\/)|(?:(?:watch)?\?v(?:i)?=|\&v(?:i)?=))([^#\&\?]*).*/;
const getVideoId = url => url && youtubeVideoRegex.exec(url)?.[1];

interface Props {
  posts: ApiBlogPostBlogPost[];
}

const { posts } = Astro.props;
---

<section class="posts">
  {
    posts.map(post => {
      const youtubeVideoId = getVideoId(post.attributes.youtubeVideo);

      return (
        <a
          class="post"
          href={
            youtubeVideoId ? `https://youtube.com/watch?v=${youtubeVideoId}` : `/blog/${slugify(post.attributes.title)}`
          }
          target={youtubeVideoId && "_blank"}
        >
          <div class="cover-container">
            <Image
              class="cover"
              width={360}
              height={200}
              alt={post.attributes.title + " cover"}
              src={post.attributes.cover.data.attributes.url}
            />
            {youtubeVideoId && (
              <>
                <div class="darken" />
                <i class="fa-solid fa-play video-icon" />
              </>
            )}
          </div>
          <div class="content">
            <div class="date">
              {new Date(post.attributes.date).toLocaleString("en-CA", {
                month: "long",
                day: "numeric",
                year: "numeric"
              })}
            </div>
            <div class="title">{post.attributes.title}</div>
            <div class="description">{post.attributes.description}</div>
          </div>
        </a>
      );
    })
  }
</section>

<style>
  .posts {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
    width: 100%;
    justify-content: center;
  }

  .post {
    color: white;
    background-color: var(--secondary);
    width: 100%;
    border-radius: 10px;
    max-width: 360px;
    display: block;
    text-decoration: none;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .cover-container {
    position: relative;
    width: 360px;
    height: 200px;
    overflow: hidden;
    border-radius: 10px;
  }

  .darken {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.25);
    transition: opacity 0.2s;
  }

  .video-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 48px;
    color: white;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
    transition: opacity 0.2s;
  }

  .cover-container:hover .darken,
  .cover-container:hover .video-icon {
    opacity: 0;
  }

  .cover {
    object-fit: cover;
    transition: transform 0.2s;
  }

  .cover-container:hover .cover {
    transform: scale(1.05);
  }

  .content {
    padding: 16px;
  }

  .date {
    color: darkgray;
    font-family: "Space Mono", monospace;
    font-size: 14px;
  }

  .title {
    font-weight: bold;
    font-size: 24px;
    margin-top: 4px;
  }

  .description {
    color: lightgray;
    font-size: 16px;
    margin-top: 4px;
  }
</style>
