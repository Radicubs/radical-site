---
import External from "./External.astro";
import Link from "./Link.astro";

interface Props {
  url: string;
  season: string;
}

const { url, season } = Astro.props;
---

<h3 class="application">
  <Link href={url}>{season}-{season + 1} Application Now Open <External /></Link>
</h3>

<style>
  .application {
    position: absolute;
    bottom: -40px;
    z-index: 1;
    background-color: black;
    border: 2px solid var(--accent);
    box-shadow: 4px 4px 8px 0px rgba(0, 0, 0, 0.5);
    padding: 20px;
  }
</style>
