---
import Icon from '../Icon.astro';
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { formatDate } from '../../utils/formatDate.js';

const { posts = [] } = Astro.props;
---

<div class="w-full pt-32 pb-24 px-6 md:px-16 lg:px-24 bg-[#101215]">
  <SectionHeader title="Team Blog" subtitle="News, updates, and stories from the Radicubs." level="h1" />

  <div class="max-w-7xl mx-auto">
    {
      posts.length === 0 ? (
        <div class="border border-dashed border-[#2c303a] rounded-lg p-16 text-center">
          <Icon name="BookOpen" size={48} class="mx-auto text-[#2c303a] mb-4" />
          <h2 class="text-xl font-mono text-white mb-2">Blog posts coming soon.</h2>
          <p class="text-[#a9a9a9]">We are currently syncing our latest updates from radicubs.com.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <Card href={`/blog/${post.slug}/`} class="flex flex-col h-full !p-0 overflow-hidden">
              <div class="w-full h-48 bg-[#2c303a] relative flex items-center justify-center border-b border-[#1b1d23]">
                {post.imageUrl ? (
                  <img src={post.imageUrl} alt={post.title} class="w-full h-full object-cover" />
                ) : (
                  <span class="text-[#101215] font-mono font-bold tracking-widest text-xs">BLOG IMAGE</span>
                )}
              </div>
              <div class="p-6 flex flex-col flex-grow bg-[#1b1d23]">
                <div class="flex items-center gap-2 text-[#a9a9a9] font-mono text-xs mb-3">
                  <Icon name="Calendar" size={14} />
                  {formatDate(post.date)}
                </div>
                <h2 class="text-xl font-mono font-bold text-white mb-3">{post.title}</h2>
                <p class="text-[#d3d3d3] text-sm mb-6 flex-grow">{post.description}</p>
                <div class="text-[#5ddb27] font-mono text-sm flex items-center gap-2 mt-auto">
                  Read Article <Icon name="ChevronRight" size={16} />
                </div>
              </div>
            </Card>
          ))}
        </div>
      )
    }
  </div>
</div>
