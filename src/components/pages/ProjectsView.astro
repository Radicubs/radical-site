---
import Icon from '../Icon.astro';
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { renderBlocks } from '../../lib/renderBlocks.js';

const { projects = [] } = Astro.props;

const ongoingProjects = [];
const pastProjects = [];
for (const project of projects) {
  if (project?.timeline === 'Present') ongoingProjects.push(project);
  else if (project?.timeline === 'Past') pastProjects.push(project);
}

const pastIcons = ['Cpu', 'BookOpen', 'Users', 'Zap'];
---

<div class="w-full pt-24 bg-[#101215]">
  <section class="px-6 md:px-16 lg:px-24 mb-16 max-w-7xl mx-auto">
    <SectionHeader
      title="Projects & Impact"
      subtitle="Impacting 2,500+ people annually through outreach, mentorship, and advocacy."
    />
  </section>

  <section class="bg-[#1b1d23] py-20 px-6 md:px-16 lg:px-24 mb-16 border-y border-[#2c303a]">
    <div class="max-w-7xl mx-auto">
      <h3 class="text-3xl font-mono text-white mb-10 border-b border-[#2c303a] pb-4 inline-flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[#5ddb27]" /> Ongoing Projects
      </h3>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        {ongoingProjects.length === 0 && (
          <div class="text-center text-[#a9a9a9] font-mono text-sm col-span-full">No ongoing projects yet.</div>
        )}

        {
          ongoingProjects.map((project) => {
            const href = project.buttonLink || 'mailto:radicubs@gmail.com';
            const buttonText = project.buttonText || 'Contact radicubs@gmail.com to get involved';
            const hasBlocks = Array.isArray(project.descriptionBlocks) && project.descriptionBlocks.length > 0;

            return (
              <div class="bg-[#101215] rounded-lg p-8 border border-[#2c303a] card-hover flex flex-col">
                {project.imageUrl && (
                  <div class="w-full h-56 bg-[#2c303a] rounded-md overflow-hidden mb-6">
                    <img src={project.imageUrl} alt={project.title} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                )}
                <div class="flex flex-col mb-6">
                  <h4 class="text-2xl font-mono text-white mb-2">{project.title}</h4>
                </div>

                <div class="mb-6 space-y-4">
                  {hasBlocks ? (
                    <Fragment set:html={renderBlocks(project.descriptionBlocks)} />
                  ) : (
                    <p class="text-[#d3d3d3] whitespace-pre-line">{project.description}</p>
                  )}
                </div>

                {project.button && (
                  <div class="mt-auto pt-6 border-t border-[#2c303a]">
                    <a
                      href={href}
                      class="inline-block w-full text-center font-mono font-bold bg-[#5ddb27] text-[#101215] py-3 rounded hover:bg-white transition-colors uppercase tracking-wider text-sm"
                    >
                      {buttonText}
                    </a>
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="px-6 md:px-16 lg:px-24 mb-24 max-w-7xl mx-auto">
    <h3 class="text-3xl font-mono text-white mb-10 border-b border-[#2c303a] pb-4 inline-flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-[#2c303a] border border-[#5ddb27]" /> Past Projects & Outreach
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {pastProjects.length === 0 && (
        <div class="text-center text-[#a9a9a9] font-mono text-sm col-span-full">No past projects yet.</div>
      )}

      {
        pastProjects.map((project, index) => {
          const iconName = pastIcons[index % pastIcons.length];
          const hasBlocks = Array.isArray(project.descriptionBlocks) && project.descriptionBlocks.length > 0;

          return (
            <Card>
              {project.imageUrl && (
                <div class="w-full h-40 bg-[#1b1d23] rounded-md overflow-hidden mb-4 border border-[#1b1d23]">
                  <img src={project.imageUrl} alt={project.title} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="text-[#5ddb27] mb-4">
                <Icon name={iconName} size={32} />
              </div>
              <h4 class="text-xl font-mono text-white mb-3">{project.title}</h4>
              <div class="text-[#a9a9a9] mb-4 space-y-3">
                {hasBlocks ? (
                  <Fragment set:html={renderBlocks(project.descriptionBlocks)} />
                ) : (
                  <p class="whitespace-pre-line">{project.description}</p>
                )}
              </div>
            </Card>
          );
        })
      }
    </div>
  </section>
</div>
