---
import Icon from '../Icon.astro';
import Button from '../ui/Button.astro';
import { formatDate } from '../../utils/formatDate.js';
import { renderBlocks } from '../../lib/renderBlocks.js';

const { post = null } = Astro.props;
---

{
  !post ? (
    <div class="w-full pt-32 px-6 md:px-16 lg:px-24 bg-[#101215] min-h-screen text-center">
      <h3 class="text-white font-mono text-2xl mb-4">Post Data Syncing...</h3>
      <Button href="/blog" variant="outline" class="mx-auto">
        Return to Blog
      </Button>
    </div>
  ) : (
    <div class="w-full pt-32 px-6 md:px-16 lg:px-24 bg-[#101215] min-h-screen pb-24">
      <div class="max-w-3xl mx-auto">
        <a
          href="/blog"
          class="text-[#a9a9a9] hover:text-[#5ddb27] font-mono text-sm flex items-center gap-2 mb-8 transition-colors"
        >
          <Icon name="ArrowRight" size={16} class="rotate-180" /> Back to Blog
        </a>

        {post.imageUrl && (
          <img
            src={post.imageUrl}
            alt={post.title}
            class="w-full h-64 md:h-96 object-cover rounded-lg mb-8 border border-[#2c303a]"
          />
        )}

        <div class="mb-8 border-b border-[#2c303a] pb-8">
          <div class="text-[#5ddb27] font-mono text-sm mb-4 flex items-center gap-2">
            <Icon name="Calendar" size={14} /> {formatDate(post.date)}
          </div>
          <h1 class="text-4xl md:text-5xl font-mono font-bold text-white leading-tight">{post.title}</h1>
        </div>

        <div class="text-lg text-[#d3d3d3] leading-relaxed space-y-6">
          {Array.isArray(post.body) && post.body.length > 0 ? (
            <Fragment set:html={renderBlocks(post.body, { variant: 'blog' })} />
          ) : (
            <p>{post.description ?? ''}</p>
          )}
        </div>
      </div>
    </div>
  )
}
