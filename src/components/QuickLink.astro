---
import External from "./External.astro";

interface Props {
  href: string;
  subject: string;
  description: string;
  prefetch?: boolean;
}

const { href, subject, description, prefetch } = Astro.props;
---

<a class="quick-link" href={href} data-astro-prefetch={prefetch}>
  <div class="subject">{subject}</div>
  <p class="description">
    {description + " "}
    <External />
  </p>
</a>

<style>
  .quick-link {
    flex: 1;
    min-width: 200px;
    color: white;
    text-decoration: none;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
  }

  .quick-link:hover {
    text-decoration: underline;
  }

  .subject {
    color: var(--accent);
    font-size: 16px;
    text-transform: uppercase;
    margin: 0;
    font-family: "Space Mono", monospace;
  }

  .description {
    margin: 0;
    margin-top: 12px;
    font-size: 16px;
    font-weight: 700;
  }

  @media screen and (max-width: 600px) {
    .quick-link {
      display: none;
    }
  }
</style>
