---
interface Props {
  date: string;
}

const { date } = Astro.props;
---

<div class="countdown" data-to={date} style="display: none;">
  <div class="square">
    <div class="number days"></div>
    <div class="label">Days</div>
  </div>
  <div class="square">
    <div class="number hours"></div>
    <div class="label">Hours</div>
  </div>
  <div class="square">
    <div class="number minutes"></div>
    <div class="label">Minutes</div>
  </div>
  <div class="square">
    <div class="number seconds"></div>
    <div class="label">Seconds</div>
  </div>
</div>

<style>
  .countdown {
    font-family: "Roboto Mono", monospace;
    display: flex;
    gap: 10px;
    justify-content: space-around;
    margin-top: 60px;
    position: absolute;
    bottom: -40px;
  }

  .square {
    z-index: 1;
    background-color: black;
    border: 2px solid var(--accent);
    width: 120px;
    height: 120px;
    box-shadow: 4px 4px 8px 0px rgba(0, 0, 0, 0.5);
  }

  .number {
    font-size: 48px;
    font-weight: bold;
    color: var(--accent);
    text-align: center;
    margin-top: 10px;
  }

  .label {
    font-size: 16px;
    font-weight: bold;
    color: lightgray;
    text-align: center;
  }
</style>

<script>
  for (const countdown of document.querySelectorAll<HTMLDivElement>(".countdown")) {
    const to = new Date(countdown.getAttribute("data-to")).getTime();

    const $days = countdown.querySelector(".days");
    const $hours = countdown.querySelector(".hours");
    const $minutes = countdown.querySelector(".minutes");
    const $seconds = countdown.querySelector(".seconds");

    function update() {
      const diff = to - Date.now();

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      $days.textContent = days.toString();
      $hours.textContent = hours.toString();
      $minutes.textContent = minutes.toString();
      $seconds.textContent = seconds.toString();
    }

    setInterval(update, 1000);
    update();
    countdown.style.display = "flex";
  }
</script>
