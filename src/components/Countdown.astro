---
interface Props {
  date: string;
}

const { date } = Astro.props;
---

<div class="container" style="display: none;">
  <h4 class="heading">Countdown to our next competition...</h4>
  <div class="countdown" data-to={date}>
    <div class="square">
      <div class="number days"></div>
      <div class="label">Days</div>
    </div>
    <div class="square">
      <div class="number hours"></div>
      <div class="label">Hours</div>
    </div>
    <div class="square">
      <div class="number minutes"></div>
      <div class="label">Minutes</div>
    </div>
    <div class="square">
      <div class="number seconds"></div>
      <div class="label">Seconds</div>
    </div>
  </div>
</div>

<style>
  .container {
    position: absolute;
    bottom: -40px;
    z-index: 1;
  }

  .heading {
    text-align: center;
    font-family: "Space Mono", monospace;
  }

  .countdown {
    font-family: "Roboto Mono", monospace;
    display: flex;
    gap: 10px;
    justify-content: space-around;
  }

  .square {
    background-color: black;
    border: 2px solid var(--accent);
    width: 120px;
    height: 120px;
    box-shadow: 4px 4px 8px 0px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .number {
    font-size: 48px;
    font-weight: bold;
    color: var(--accent);
    text-align: center;
  }

  .label {
    font-size: 16px;
    font-weight: bold;
    color: lightgray;
    text-align: center;
  }

  @media (max-width: 600px) {
    .square {
      width: 80px;
      height: 80px;
    }

    .number {
      font-size: 36px;
    }

    .label {
      font-size: 12px;
    }
  }

  @media screen and (max-width: 360px), screen and (max-height: 640px) {
    .container {
      display: none;
    }
  }
</style>

<script>
  for (const countdown of document.querySelectorAll<HTMLDivElement>(".countdown")) {
    const to = new Date(countdown.getAttribute("data-to")).getTime();
    const diff = to - new Date().getTime();
    if (diff < 0) continue;

    const $days = countdown.querySelector(".days");
    const $hours = countdown.querySelector(".hours");
    const $minutes = countdown.querySelector(".minutes");
    const $seconds = countdown.querySelector(".seconds");

    let interval: ReturnType<typeof setTimeout>;

    function update() {
      const diff = to - Date.now();
      if (diff < 0) return clearInterval(interval);

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      $days.textContent = days.toString();
      $hours.textContent = hours.toString();
      $minutes.textContent = minutes.toString();
      $seconds.textContent = seconds.toString();
    }

    interval = setInterval(update, 1000);
    update();

    countdown.parentElement.style.display = null;
  }
</script>
