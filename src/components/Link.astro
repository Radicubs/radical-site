---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href}><slot /></a>

<style>
  a {
    color: white;
    position: relative;
    text-decoration: none;
  }

  a::before {
    content: "";
    position: absolute;
    display: block;
    width: 0%;
    height: 1px;
    bottom: 0;
    left: 0;
    background-color: var(--accent);
    transition: width 0.3s ease;
  }

  a:hover::before {
    width: 100%;
  }
</style>
