---
import External from "../components/External.astro";
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
import type { ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Contact">
  <div class="container">
    <h1>Contact Us</h1>
    <form class="form" method="post" action={import.meta.env.CONTACT_API_URL}>
      <div id="status" class="status hidden">
        <p id="status-message" class="status-message"></p>
      </div>
      <input type="text" id="name" name="name" placeholder="Name" required />
      <input type="email" id="email" name="email" placeholder="Email" required />
      <textarea id="message" name="message" placeholder="Message" maxlength="1500"></textarea>
      <button type="submit" id="submit" class="submit"><i class="fa-solid fa-paper-plane"></i> Send</button>
      <!-- turnstile -->
      <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </form>
    <div class="application">
      <Link href={home.attributes.applicationUrl}>
        Apply for the {home.attributes.applicationSeason}-{home.attributes.applicationSeason + 1} season <External />
      </Link>
    </div>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const success = params.get("success");
  const message = params.get("message");

  if (success && message) {
    const $status = document.getElementById("status");
    const $message = document.getElementById("status-message");

    if (success === "true") {
      $status.classList.add("success");
    } else {
      $status.classList.add("error");
    }

    $status.classList.remove("hidden");
    $message.innerText = message;
  }
</script>

<style>
  .container {
    padding: 32px;
  }

  .status {
    max-width: 400px;
    width: 100%;
    border-radius: 4px;
    padding: 10px;
  }

  .status.hidden {
    display: none;
  }

  .status.success {
    background: #3c6927;
  }

  .status.error {
    background: #692727;
  }

  .status-message {
    text-align: center;
    margin: 0;
    font-size: 16px;
    color: white;
    font-weight: #cccccc;
    font-family: "Space Mono", monospace;
  }

  .form {
    color: var(--accent);
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: 60px;
    font-weight: 700;
    font-family: "Space Mono", monospace;
    color: var(--accent);
    text-align: center;
  }

  input,
  textarea,
  .submit {
    width: 100%;
    max-width: 400px;
    font-family: "Space Mono", monospace;
    padding: 16px;
  }

  input,
  textarea {
    border: 2px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    height: 50px;
    font-size: 16px;
    color: var(--accent);
  }

  textarea {
    height: 200px;
  }

  .submit {
    font-size: 20px;
    cursor: pointer;
    border: none;
    color: white;
    border-radius: 4px;
    background-color: green;
  }

  .email {
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--accent);
    font-size: 32px;
  }

  .application {
    text-align: center;
    font-weight: bold;
  }
</style>
