---
import Layout from "../layouts/Layout.astro";

const success = Astro.url.searchParams.get("success") === "true";
const message = Astro.url.searchParams.get("message");
---

<Layout title="Contact">
  <div class="container">
    <h1>Contact Us</h1>
    <form class="form" method="post" action="/api/contact">
      {
        message && (
          <div class:list={["status", success ? "success" : "error"]}>
            <p class="status-message">{message}</p>
          </div>
        )
      }
      <input type="text" id="name" name="name" placeholder="Name" required />
      <input type="email" id="email" name="email" placeholder="Email" required />
      <textarea id="message" name="message" placeholder="Message" maxlength="1500"></textarea>
      <input id="submit" class="btn" type="submit" value="Send Mail" />
    </form>
  </div>
</Layout>

<style>
  .container {
    padding: 32px;
  }

  .status {
    max-width: 400px;
    width: 100%;
    border-radius: 4px;
    padding: 10px;
  }

  .status.success {
    background: #3c6927;
  }

  .status.error {
    background: #692727;
  }

  .status-message {
    text-align: center;
    margin: 0;
    font-size: 16px;
    color: white;
    font-weight: #cccccc;
    font-family: "Space Mono", monospace;
  }

  .form {
    color: var(--accent);
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: 60px;
    font-weight: 700;
    margin: 0;
    font-family: "Space Mono", monospace;
    color: var(--accent);
    text-align: center;
  }

  input,
  textarea {
    width: 100%;
    max-width: 400px;
    border: 2px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    height: 50px;
    font-size: 16px;
    padding: 16px;
    color: var(--accent);
    font-family: "Space Mono", monospace;
  }

  textarea {
    height: 200px;
  }

  .btn {
    font-family: "Space Mono", monospace;
    font-size: 20px;
    cursor: pointer;
    padding: 5px 20px;
    border: none;
    color: white;
    border-radius: 4px;
    font-size: 20px;
    text-decoration: none;

    --color: #3c6927; /* the color*/

    box-shadow: 0 0 0 0.1em inset var(--color);
    --gradient: linear-gradient(var(--color) 0 0) no-repeat;
    background:
      var(--gradient) calc(var(--pos, 0%) - 100%) 0%,
      var(--gradient) calc(200% - var(--pos, 0%)) 0%,
      var(--gradient) calc(var(--pos, 0%) - 100%) 100%,
      var(--gradient) calc(200% - var(--pos, 0%)) 100%;
    background-size: 50.5% calc(var(--pos, 0%) / 2 + 0.5%);
    outline-offset: 0.1em;
    transition:
      background-size 0.2s,
      background-position 0s 0.2s;
  }
  .btn:hover {
    --pos: 100%;
    transition:
      background-position 0.2s,
      background-size 0s;
  }
  .btn:active {
    box-shadow: 0 0 9e9Q inset #0009;
    background-color: var(--color);
    color: #fff;
  }

  .email {
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--accent);
    font-size: 32px;
  }
</style>
