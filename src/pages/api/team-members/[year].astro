---
import type { GetStaticPaths } from "astro";
import type { ApiTeamMemberTeamMember } from "../../../lib/contentTypes";
import { getTeamMembers, getYears, sortMembers } from "../../../lib/team";
import fetchApi from "../../../lib/strapi";
import TeamMember from "../../../components/TeamMember.astro";

export const getStaticPaths = (async () => {
  const years = await getYears();
  return years.map(year => ({ params: { year: year.toString() } }));
}) satisfies GetStaticPaths;

const year = parseInt(Astro.params.year);
if (!year) {
  throw new Response("Not found", { status: 404 });
}

const teamMembers = await getTeamMembers(year);
---

{
  teamMembers.map(member => (
    <TeamMember
      name={member.attributes.name}
      role={member.attributes.role}
      photo_url={
        member.attributes.avatar.data ? import.meta.env.STRAPI_URL + member.attributes.avatar.data.attributes.url : null
      }
    />
  ))
}
