---
import type { GetStaticPaths } from "astro";
import type { ApiTeamMemberTeamMember } from "../../../lib/contentTypes";
import fetchApi from "../../../lib/strapi";
import TeamMember from "../../../components/TeamMember.astro";

const year = Astro.params.year;
if (!year) {
  throw new Response("Not found", { status: 404 });
}

const teamMembers = await fetchApi<ApiTeamMemberTeamMember[]>({
  endpoint: "team-members", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*", "filters[year][$eq]": year }
});

export const getStaticPaths = (() => {
  return [2018, 2019, 2020, 2021, 2022, 2023].map(year => ({ params: { year: year.toString() } }));
}) satisfies GetStaticPaths;
---

{
  teamMembers.map(member => (
    <TeamMember
      name={member.attributes.name}
      role={member.attributes.role}
      photo_url={
        member.attributes.avatar.data ? import.meta.env.STRAPI_URL + member.attributes.avatar.data.attributes.url : null
      }
    />
  ))
}
