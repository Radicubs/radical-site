---
import BlogPosts from "../components/BlogPosts.astro";
import Layout from "../layouts/Layout.astro";
import type { ApiBlogPostBlogPost } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const posts = await fetchApi<ApiBlogPostBlogPost[]>({
  endpoint: "blog-posts", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*", sort: "date:desc", "pagination[limit]": "1000" }
});
---

<Layout title="Blog">
  <div class="container">
    <h1>Blog</h1>
    <BlogPosts posts={posts} />
  </div>

  <style>
    .container {
      padding: 32px;
      max-width: 1200px;
      margin: auto;
    }

    h1 {
      font-size: 60px;
      font-weight: 700;
      font-family: "Space Mono", monospace;
      color: var(--accent);
      text-align: center;
    }
  </style>
</Layout>
