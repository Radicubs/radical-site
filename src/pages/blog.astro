---
import Layout from "../layouts/Layout.astro";
import { slugify } from "../lib/blog";
import type { ApiBlogPostBlogPost } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const posts = await fetchApi<ApiBlogPostBlogPost[]>({
  endpoint: "blog-posts", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Blog">
  <div class="container">
    <h1>Blog</h1>
    <div class="posts">
      {
        posts.map(post => (
          <a class="post" href={`/blog/${slugify(post.attributes.title)}`}>
            <img
              src={import.meta.env.STRAPI_URL + post.attributes.cover.data.attributes.url}
              alt={post.attributes.title + " cover"}
            />
            <div class="content">
              <div class="date">
                {new Date(post.attributes.createdAt).toLocaleString("en-CA", {
                  month: "long",
                  day: "numeric",
                  year: "numeric"
                })}
              </div>
              <div class="title">{post.attributes.title}</div>
              <div class="description">{post.attributes.description}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .container {
    padding: 32px;
  }

  h1 {
    font-size: 60px;
    font-weight: 700;
    font-family: "Space Mono", monospace;
    color: var(--accent);
    text-align: center;
  }

  .posts {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 32px;
    max-width: 1300px;
    width: 100%;
    margin: auto;
    justify-content: center;
  }

  .post {
    color: white;
    background-color: var(--secondary);
    width: 100%;
    border-radius: 10px;
    max-width: 360px;
    display: block;
    text-decoration: none;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .post img {
    width: 100%;
    height: 200px;
    border-radius: 10px;
    object-fit: cover;
  }

  .content {
    padding: 16px;
  }

  .date {
    color: darkgray;
    font-family: "Space Mono", monospace;
    font-size: 14px;
  }

  .title {
    font-weight: bold;
    font-size: 24px;
    margin-top: 4px;
  }

  .description {
    color: lightgray;
    font-size: 16px;
    margin-top: 4px;
  }
</style>
