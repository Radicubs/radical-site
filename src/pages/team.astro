---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";

import { getTeamMembers, getYears } from "../lib/team";
import TeamMember from "../components/TeamMember.astro";
import External from "../components/External.astro";
import type { ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const years = await getYears();
const currentMembers = await getTeamMembers(years[0]);

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Team">
  <div class="container">
    <div class="heading">
      <h1>Meet the Team</h1>
      <select name="Year" id="year">
        {
          years.map(year => (
            <option value={year}>
              {year} - {year + 1}
            </option>
          ))
        }
      </select>
      <div class="links">
        <Link href="/mentors">View mentors <External /></Link>
        {
          home.attributes.applicationUrl && (
            <Link href={home.attributes.applicationUrl}>
              Apply for the {home.attributes.applicationSeason}-{home.attributes.applicationSeason + 1} season{" "}
              <External />
            </Link>
          )
        }
      </div>
    </div>
    <div id="team-members" class="team-members">
      {
        currentMembers.map(member => (
          <TeamMember
            name={member.attributes.name}
            role={member.attributes.role}
            photo_url={member.attributes.avatar.data?.attributes.url}
          />
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .links {
    width: 100%;
    font-size: 20px;
    font-weight: bold;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 32px;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  h1 {
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 0;
    text-align: center;
    display: inline-block;
  }

  select {
    padding: 10px;
    font-size: 16px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background-color: var(--primary);
    color: var(--accent);
    font-family: "Space Mono", monospace;
  }

  select option {
    position: relative;
    background-color: var(--secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .team-members {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }
</style>

<script>
  const teamMembersElement = document.getElementById("team-members") as HTMLDivElement;
  const yearSelect = document.getElementById("year") as HTMLSelectElement;

  yearSelect.addEventListener("change", () => {
    const year = yearSelect.value;
    fetch(`/api/team-members/${encodeURIComponent(year)}/`)
      .then(res => res.text())
      .then(res => (teamMembersElement.innerHTML = res));
  });
</script>
