---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";

import { getTeamMembers, getYears } from "../lib/team";
import TeamMember from "../components/TeamMember.astro";
import External from "../components/External.astro";

const years = await getYears();
const currentMembers = await getTeamMembers(years[0]);
---

<Layout title="Team">
  <div class="container">
    <div class="heading">
      <h1>Meet the Team</h1>
      <select name="Year" id="year">
        {
          years.map(year => (
            <option value={year}>
              {year} - {year + 1}
            </option>
          ))
        }
      </select>
    </div>
    <div class="mentors">
      <Link href="/mentors">View mentors <External /></Link>
    </div>
    <div id="team-members" class="team-members">
      {
        currentMembers.map(member => (
          <TeamMember
            name={member.attributes.name}
            role={member.attributes.role}
            photo_url={
              member.attributes.avatar.data
                ? import.meta.env.STRAPI_URL + member.attributes.avatar.data.attributes.url
                : null
            }
          />
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .mentors {
    font-size: 20px;
    font-weight: bold;
    margin: auto;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  h1 {
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 0;
    text-align: center;
    display: inline-block;
  }

  select {
    margin-left: 10px;
    padding: 10px;
    font-size: 16px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background-color: var(--primary);
    color: var(--accent);
    font-family: "Space Mono", monospace;
  }

  select option {
    position: relative;
    background-color: var(--secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .team-members {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
  }
</style>

<script>
  const teamMembersElement = document.getElementById("team-members") as HTMLDivElement;
  const yearSelect = document.getElementById("year") as HTMLSelectElement;

  yearSelect.addEventListener("change", () => {
    const year = yearSelect.value;
    fetch(`/api/team-members/${encodeURIComponent(year)}/`)
      .then(res => res.text())
      .then(res => (teamMembersElement.innerHTML = res));
  });
</script>
