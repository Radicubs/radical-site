---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";

import type { ApiTeamMemberTeamMember } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";
import TeamMember from "../components/TeamMember.astro";

const teamMembers = await fetchApi<ApiTeamMemberTeamMember[]>({
  endpoint: "team-members", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const teamMembersByYear = Array.from(
  teamMembers.reduce((acc, member) => {
    const year = member.attributes.year;
    if (!acc.has(year)) acc.set(year, []);
    acc.get(year).push(member);
    return acc;
  }, new Map())
).sort(([yearA], [yearB]) => yearB - yearA);
---

<Layout title="Team">
  <div class="container">
    <div class="heading">
      <h1>Meet the Team</h1>
      <select name="Year" id="year">
        {
          teamMembersByYear.map(([year]) => (
            <option value={year}>
              {year} - {year + 1}
            </option>
          ))
        }
      </select>
    </div>
    <Link text="Mentors" href="/mentors" />
    <div id="team-members" class="team-members">
      {
        teamMembersByYear[0][1].map(member => (
          <TeamMember
            name={member.attributes.name}
            role={member.attributes.role}
            photo_url={
              member.attributes.avatar.data
                ? import.meta.env.STRAPI_URL + member.attributes.avatar.data.attributes.url
                : null
            }
          />
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  h1 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    display: inline-block;
  }

  select {
    margin-left: 10px;
    padding: 10px;
    font-size: 16px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background-color: var(--primary);
    color: var(--accent);
    font-family: "Space Mono", monospace;
  }

  select option {
    position: relative;
    background-color: var(--secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px;
    gap: 16px;
    display: flex;
    flex-direction: column;
  }

  .team-members {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
</style>

<script>
  const teamMembersElement = document.getElementById("team-members") as HTMLDivElement;
  const yearSelect = document.getElementById("year") as HTMLSelectElement;

  yearSelect.addEventListener("change", () => {
    const year = yearSelect.value;
    fetch(`/api/team-members/${encodeURIComponent(year)}`)
      .then(res => res.text())
      .then(res => (teamMembersElement.innerHTML = res));
  });
</script>
