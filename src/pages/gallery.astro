---
import Image from "../components/Image.astro";
import Layout from "../layouts/Layout.astro";
import { slugify } from "../lib/blog";
import fetchApi from "../lib/strapi";

const albums = await fetchApi<any[]>({
  endpoint: "albums", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Gallery">
  <div class="container">
    <h1>Gallery</h1>
    <div class="albums">
      {
        albums.map(album => (
          <a class="album" href={`/gallery/${slugify(album.attributes.title)}`}>
            <div class="cover-container">
              <Image
                class="cover"
                src={album.attributes.cover.data.attributes.url}
                alt={album.attributes.title}
                width="240"
                height="240"
              />
            </div>
            <div class="title">{album.attributes.title}</div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .container {
    padding: 32px;
    max-width: 1096px;
    margin: auto;
  }

  h1 {
    text-align: center;
  }

  .albums {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
    width: 100%;
    justify-content: center;
  }

  .album {
    width: 240px;
    cursor: pointer;
    color: white;
    text-decoration: none;
  }

  .cover-container {
    width: 240px;
    height: 240px;
    border-radius: 10px;
    overflow: hidden;
  }

  .cover {
    object-fit: cover;
    transition: transform 0.2s;
  }

  .album:hover .cover {
    transform: scale(1.05);
  }

  .title {
    margin-top: 10px;
    font-size: 20px;
    font-weight: bold;
  }
</style>
