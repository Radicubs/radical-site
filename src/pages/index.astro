---
import BlogPosts from "../components/BlogPosts.astro";
import BlogPost from "../components/BlogPosts.astro";
import CorporateSponsors from "../components/CorporateSponsors.astro";
import Image from "../components/Image.astro";
import Layout from "../layouts/Layout.astro";
import type { ApiBlogPostBlogPost, ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const blogPosts = await fetchApi<ApiBlogPostBlogPost[]>({
  endpoint: "blog-posts", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*", sort: "date:desc", "pagination[limit]": "3" }
});
---

<Layout title="Home">
  <script is:inline>
    function drive() {
      const bobot = document.getElementById("bobot");
      bobot.classList.add("drive");
      setTimeout(() => bobot.classList.remove("drive"), 5000);
    }
  </script>
  <header>
    <div class="content">
      <h1 onclick="drive()">{home.attributes.name}</h1>
      <div class="subheading">{home.attributes.description}</div>
      <div class="socials">
        <a href="https://instagram.com/theradicubs"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://twitter.com/theradicubs"><i class="fa-brands fa-twitter"></i></a>
        <a href="https://www.tiktok.com/@theradicubs"><i class="fa-brands fa-tiktok"></i></a>
        <a href="https://youtube.com/channel/UCNuzQPRdm0OBcJaWgX8z6eQ"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>
    <img id="bobot" src="/bobot.png" alt="bobot" class="bobot" />
  </header>
  <div class="container">
    <div class="section-heading">
      <h2>Sponsors</h2>
      <hr />
    </div>
    <CorporateSponsors />
    <div class="section-heading">
      <h2>Latest Updates</h2>
      <hr />
    </div>
    <BlogPosts posts={blogPosts} />
    <footer>The Radicubs Robotics Team is recognized as a non-profit organization under a 501(c)(3).</footer>
  </div>
</Layout>

<style is:global>
  #root {
    height: 100%;
  }
</style>

<style>
  .container {
    max-width: 1200px;
    margin: auto;
    padding: 32px;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  hr {
    border: 2px solid var(--accent);
    max-width: 100px;
    margin-left: 0;
    margin-bottom: 20px;
  }

  header {
    color: white;
    height: 80%;
    gap: 32px;
    padding: 32px;
    /* background-color: black; */
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url(/hexagon.jpg); /* we cant use this image its an adobe stock image */
    background-size: cover;
    position: relative;
  }

  .content {
    max-width: 600px;
  }

  h1 {
    font-size: 64px;
    font-weight: 700;
    margin: 0;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  .subheading {
    color: lightgray;
    font-size: 20px;
  }

  .socials {
    margin-top: 32px;
    font-size: 32px;
    display: flex;
    gap: 8px;
  }

  .socials > a {
    color: var(--accent);
  }

  .bobot {
    position: fixed;
    bottom: -25px;
    right: -360px; /* real width is 355.77px */
    height: 400px;
    transition: right 2s;
    filter: drop-shadow(0 0 10px black);
    overflow: hidden;
  }

  .bobot.drive {
    animation: drive 5s ease-in-out;
  }

  @keyframes drive {
    0% {
      right: -500px;
    }
    100% {
      right: 100vw;
    }
  }

  footer {
    text-align: center;
    margin-top: 32px;
    color: lightgray;
  }
</style>
