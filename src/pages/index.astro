---
import Layout from "../layouts/Layout.astro";
import type { ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Home">
  <header>
    <div class="content">
      <h1>{home.attributes.name}</h1>
      <div class="subheading">{home.attributes.description}</div>
      <div class="socials">
        <a href="https://instagram.com/theradicubs"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://twitter.com/theradicubs"><i class="fa-brands fa-twitter"></i></a>
        <a href="https://www.tiktok.com/@theradicubs"><i class="fa-brands fa-tiktok"></i></a>
        <a href="https://youtube.com/channel/UCNuzQPRdm0OBcJaWgX8z6eQ"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>
    <div class="media">
      <img
        src={import.meta.env.STRAPI_URL + home.attributes.image.data.attributes.url}
        alt="Radicubs Logo"
        class="logo"
        width="400"
        height="400"
      />
    </div>
  </header>
</Layout>

<style is:global>
  #root {
    height: 100%;
  }
</style>

<style>
  header {
    color: white;
    height: 100%;
    gap: 32px;
    padding: 32px;
    /* background-color: black; */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content {
    width: 40%;
  }

  h1 {
    font-size: 64px;
    font-weight: 700;
    margin: 0;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  .subheading {
    color: lightgray;
    font-size: 20px;
  }

  .socials {
    margin-top: 32px;
    font-size: 32px;
    display: flex;
    gap: 8px;
  }

  .socials > a {
    color: var(--accent);
  }

  .logo {
    /* border-radius: 9999px; */
  }

  /* mobile no .media */
  @media (max-width: 768px) {
    .content {
      width: 100%;
    }

    .media {
      display: none;
    }
  }
</style>
