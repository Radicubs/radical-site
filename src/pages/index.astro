---
import Awards from "../components/Awards.astro";
import BlogPosts from "../components/BlogPosts.astro";
import CorporateSponsors from "../components/CorporateSponsors.astro";
import Layout from "../layouts/Layout.astro";
import type { ApiBlogPostBlogPost, ApiHomeHome } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";
import Image from "../components/Image.astro";
import Countdown from "../components/Countdown.astro";
import Application from "../components/Application.astro";
import { Icon } from "astro-icon/components";
import GlitchText from "../components/GlitchText.astro";
import QuickLink from "../components/QuickLink.astro";
import Link from "../components/Link.astro";
import External from "../components/External.astro";
import { getVideoId, slugify } from "../lib/blog";

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const blogPosts = await fetchApi<ApiBlogPostBlogPost[]>({
  endpoint: "blog-posts", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*", sort: "date:desc", "pagination[limit]": "3" }
});

const latestPost = blogPosts[0];
const latestPostVideoId = latestPost && getVideoId(latestPost.attributes.youtubeVideo);
const latestPostHref = latestPostVideoId
  ? `https://youtube.com/watch?v=${latestPostVideoId}`
  : latestPost && `/blog/${slugify(latestPost.attributes.title)}`;
---

<Layout title="Home">
  <header>
    <div class="darken"></div>
    <div class="hero">
      <div class="content">
        <h1 class="heading" onclick="drive()"><GlitchText content={home.attributes.name} /></h1>
        <div class="subheading">{home.attributes.description}</div>
        <div class="socials">
          <a href="https://instagram.com/theradicubs"><i class="fa-brands fa-instagram"></i></a>
          <!-- <a href="https://twitter.com/theradicubs"><i class="fa-brands fa-twitter"></i></a> -->
          <a href="https://www.tiktok.com/@theradicubs"><i class="fa-brands fa-tiktok"></i></a>
          <a href="https://youtube.com/channel/UCNuzQPRdm0OBcJaWgX8z6eQ"><i class="fa-brands fa-youtube"></i></a>
          <a href="https://www.linkedin.com/company/radicubs-robotics"><i class="fa-brands fa-linkedin"></i></a>
          <a href="https://www.thebluealliance.com/team/7503"
            ><Icon name="thebluealliance" height={30} style={{ marginTop: "4px" }} /></a
          >
        </div>
        <div class="quick-links">
          {
            latestPost && (
              <QuickLink
                href={latestPostHref}
                subject="Latest update"
                description={latestPost.attributes.title}
                prefetch={!latestPostVideoId}
              />
            )
          }
          <QuickLink href={import.meta.env.DONATE_URL} subject="Support us" description="Donate to the team" />
        </div>
      </div>
    </div>
    <Countdown date={home.attributes.nextComp} />
    {
      home.attributes.applicationUrl && (
        <Application url={home.attributes.applicationUrl} season={home.attributes.applicationSeason} />
      )
    }
  </header>
  <div class="container">
    <div class="section-heading">
      <h2>Sponsors</h2>
      <hr />
    </div>
    <CorporateSponsors />
    <div class="section-heading">
      <h2>Awards</h2>
      <hr />
    </div>
    <div class="awards-row">
      <div class="awards-container">
        <div class="awards-scroll">
          <Awards />
        </div>
      </div>
      <Image
        class="team-photo"
        alt="team photo"
        src={home.attributes.image.data.attributes.url}
        width={home.attributes.image.data.attributes.width}
        height={home.attributes.image.data.attributes.height}
      />
    </div>
    <div class="section-heading">
      <h2>Latest Updates</h2>
      <hr />
    </div>
    <BlogPosts posts={blogPosts} />
    <div class="view-blog">
      <Link href="/blog">All blog posts <External /></Link>
    </div>
    <footer>
      The Radicubs Robotics Team is recognized as a non-profit organization under a 501(c)(3).
      <br />
      Header image designed by <a href="http://www.freepik.com" target="_blank" rel="noopener noreferrer">Freepik</a>
    </footer>
  </div>

  <!-- bobot -->
  <Image
    id="bobot"
    class="bobot"
    alt="bobot"
    src={home.attributes.bobot.data.attributes.url}
    width={355.77}
    height={400}
  />
  <script is:inline>
    const bobot = document.getElementById("bobot");

    function drive() {
      const clone = bobot.cloneNode();
      clone.classList.add("drive");
      document.body.appendChild(clone);
      setTimeout(() => clone.remove(), 5000);
    }
  </script>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: auto;
    padding: 32px;
  }

  hr {
    border: 2px solid var(--accent);
    max-width: 100px;
    margin-left: 0;
    margin-bottom: 20px;
  }

  header {
    color: white;
    height: 80%;
    gap: 32px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-image: url(/bg.svg); /* we cant use this image its an adobe stock image */
    background-size: cover;
    background-position: center;
    position: relative;
    justify-content: center;
  }

  .darken {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    /* keep the dark bloom centered on .content: 50% on small screens,
       pinned at 32px padding + 300px (half of .content) on mid-size,
       and 50% - 300px once .hero hits its 1200px max width */
    background-image: radial-gradient(ellipse at max(min(50%, 332px), 50% - 300px) 50%, black, transparent);
    z-index: 1;
  }

  .hero {
    width: 100%;
    max-width: 1200px;
    padding: 32px;
    z-index: 2;
  }

  .content {
    max-width: 600px;
  }

  .socials {
    margin-top: 32px;
    font-size: 32px;
    display: flex;
    gap: 8px;
  }

  .socials > a {
    color: var(--accent);
  }

  .quick-links {
    margin-top: 32px;
    display: flex;
    gap: 24px;
  }

  .awards-row {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    margin-top: 32px;
  }

  /* the photo's height drives the row; the timeline stretches to match
     and scrolls inside an absolutely-positioned box so its own height
     can't inflate the row */
  .awards-container {
    position: relative;
    flex: 1;
    align-self: stretch;
    min-width: 0;
  }

  .awards-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    padding-right: 8px;
  }

  .team-photo {
    width: 45%;
    max-width: 520px;
    height: auto;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
  }

  @media screen and (max-width: 900px) {
    .team-photo {
      display: none;
    }

    .awards-container {
      align-self: auto;
    }

    .awards-scroll {
      position: static;
      overflow-y: visible;
      padding-right: 0;
    }
  }

  .view-blog {
    width: 100%;
    font-size: 20px;
    font-weight: bold;
    margin-top: 24px;
  }

  footer {
    text-align: center;
    margin-top: 32px;
    line-height: 1.5;
    color: lightgray;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  .subheading {
    color: lightgray;
    font-size: 20px;
  }

  footer > a {
    color: lightgray;
  }

  .bobot {
    position: fixed;
    bottom: -25px;
    right: -360px; /* real width is 355.77px */
    height: 400px;
    transition: right 2s;
    filter: drop-shadow(0 0 10px black);
    overflow: hidden;
    z-index: 2;
  }

  .bobot.drive {
    animation: drive 5s ease-in-out;
  }

  @keyframes drive {
    0% {
      right: -500px;
    }
    100% {
      right: 100vw;
    }
  }
</style>
