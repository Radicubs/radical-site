---
import Layout from "../layouts/Layout.astro";

import type { ApiMentorMentor } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";
import TeamMember from "../components/TeamMember.astro";
import Link from "../components/Link.astro";
import External from "../components/External.astro";

const mentors = await fetchApi<ApiMentorMentor[]>({
  endpoint: "mentors", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Mentors">
  <div class="container">
    <h1>Mentors</h1>
    <div class="view-team">
      <Link href="/team">View team members <External /></Link>
    </div>
    <div id="team-members" class="team-members">
      {
        mentors.map(member => (
          <TeamMember
            name={member.attributes.name}
            role={member.attributes.role}
            photo_url={
              member.attributes.avatar.data
                ? import.meta.env.STRAPI_URL + member.attributes.avatar.data.attributes.url
                : null
            }
          />
        ))
      }
    </div>
  </div>

  <style>
    h1 {
      font-size: 48px;
      font-weight: 700;
      margin-bottom: 0;
      text-align: center;
      display: inline-block;
    }

    .view-team {
      font-size: 20px;
      font-weight: bold;
      margin: auto;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px;
      display: flex;
      flex-direction: column;
    }

    .team-members {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 24px;
    }
  </style>

  <script>
    const teamMembersElement = document.getElementById("team-members") as HTMLDivElement;
    const yearSelect = document.getElementById("year") as HTMLSelectElement;

    yearSelect.addEventListener("change", () => {
      const year = yearSelect.value;
      fetch(`/api/team-members/${encodeURIComponent(year)}`)
        .then(res => res.text())
        .then(res => (teamMembersElement.innerHTML = res));
    });
  </script>
</Layout>
