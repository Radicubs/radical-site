---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostView from '../../components/pages/BlogPostView.jsx';

export async function getStaticPaths() {
  const rawUrl = import.meta.env.PUBLIC_STRAPI_URL;
  if (typeof rawUrl !== 'string' || rawUrl.trim().length === 0) return [];
  const baseUrl = rawUrl.trim().replace(/\/$/, '');

  const candidateBaseUrls = [baseUrl];
  // Windows often resolves localhost to IPv6 ::1 first; if Strapi is only bound
  // to IPv4, Node fetch() can fail while the browser still succeeds.
  try {
    const parsed = new URL(baseUrl);
    if (parsed.hostname === 'localhost') {
      parsed.hostname = '127.0.0.1';
      candidateBaseUrls.push(parsed.toString().replace(/\/$/, ''));
    }
  } catch {
    // Ignore invalid URLs; fetch below will fail and return [].
  }

  for (const candidate of candidateBaseUrls) {
    try {
      const url = new URL('/api/blog-posts', candidate);
      const params = new URLSearchParams();
      params.append('fields[0]', 'Slug');
      params.set('pagination[pageSize]', '100');
      url.search = params.toString();

      const res = await fetch(url.toString(), {
        headers: { Accept: 'application/json' },
      });

      if (!res.ok) continue;

      const json = await res.json();
      const rows = Array.isArray(json?.data) ? json.data : [];

      const slugs = rows
        .map((row) => row?.attributes?.Slug ?? row?.Slug ?? null)
        .filter((slug) => typeof slug === 'string' && slug.length > 0);

      if (slugs.length === 0) continue;

      return slugs.map((slug) => ({ params: { slug } }));
    } catch {
      // Try the next candidate base URL.
    }
  }

  return [];
}

const { slug } = Astro.params;
---

<BaseLayout title="Blog | Radicubs">
  <BlogPostView client:load slug={slug} />
</BaseLayout>
