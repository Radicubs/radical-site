---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumView from '../../components/pages/AlbumView.jsx';
import { fetchAllAlbums, fetchAlbumBySlug } from '../../lib/strapiAlbums.js';

export async function getStaticPaths() {
  const albums = await fetchAllAlbums();
  return albums.map((album) => ({
    params: { slug: album.slug },
  }));
}

const { slug } = Astro.params;

const album = await fetchAlbumBySlug({ slug });

if (!album) {
  return Astro.redirect('/gallery');
}
---

<BaseLayout title={`${album.title} | Gallery | Radicubs`}>
  <AlbumView album={album} client:load />
</BaseLayout>
