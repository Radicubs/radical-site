---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import fetchApi from "../../lib/strapi";
import { slugify } from "../../lib/blog";
import Image from "../../components/Image.astro";

export const getStaticPaths = (async () => {
  const albums = await fetchApi<any[]>({
    endpoint: "albums", // the content type to fetch
    wrappedByKey: "data", // the key to unwrap the response
    query: { populate: "*" }
  });

  return albums.map(album => ({ params: { album: slugify(album.attributes.title) } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.album;
if (!slug) {
  throw new Response("Not found", { status: 404 });
}

const albums = await fetchApi<any[]>({
  endpoint: "albums", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const album = albums.find(album => slugify(album.attributes.title) === slug);
if (!album) {
  throw new Response("Not found", { status: 404 });
}
---

<Layout title="Gallery">
  <div class="container">
    <h1>{album.attributes.title}</h1>
    <div id="photos" class="photos">
      {
        album.attributes.images.data.map(image => (
          <Image
            class="photo"
            src={image.attributes.url}
            width={373.33}
            height={image.attributes.height * (373.33 / image.attributes.width)}
          />
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .container {
    padding: 32px;
    max-width: 1200px;
    margin: auto;
  }

  h1 {
    text-align: center;
  }

  .photos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .photo {
    cursor: pointer;
  }

  .title {
    margin-top: 10px;
    font-size: 20px;
    font-weight: bold;
  }
</style>

<style is:global>
  @import url("../../../node_modules/viewerjs/dist/viewer.css");
</style>

<script>
  import { JustifiedGrid } from "@egjs/grid";
  import Viewer from "viewerjs";

  const photos = document.getElementById("photos")!;
  const grid = new JustifiedGrid(photos, {
    gap: 8,
    columnRange: [1, 3],
    isConstantSize: true,
    useResizeObserver: true,
    observeChildren: true
  });

  // grid.renderItems();

  new Viewer(photos, {
    rotatable: false,
    scalable: false,
    url(el) {
      const url = new URL(el.src);
      url.searchParams.delete("w");
      url.searchParams.delete("h");
      url.searchParams.delete("s");
      url.searchParams.set("w", "1000");
      url.searchParams.set("h", "1000");
      return url.toString();
    }
  });
</script>
