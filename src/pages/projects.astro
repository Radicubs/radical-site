---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsView from '../components/pages/ProjectsView.astro';
import { fetchProjects } from '../lib/strapiProjects.js';

const projects = await fetchProjects();
---

<BaseLayout
  title="Impact | Radicubs"
  description="See how Radicubs drives STEM outreach, mentorship, and community impact through ongoing and past projects."
>
  <ProjectsView projects={projects} />
</BaseLayout>
