---
import CorporateSponsors from "../components/CorporateSponsors.astro";
import External from "../components/External.astro";
import Image from "../components/Image.astro";
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
import type { ApiHomeHome, ApiIndividualSponsorIndividualSponsor } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const individualSponsors = await fetchApi<ApiIndividualSponsorIndividualSponsor[]>({
  endpoint: "individual-sponsors", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const home = await fetchApi<ApiHomeHome>({
  endpoint: "home", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});

const packet = home.attributes.sponsorshipPacket?.data;
const packetUrl = packet && new URL(packet.attributes.url, import.meta.env.STRAPI_URL).toString();
---

<Layout title="Sponsors">
  <div class="container">
    <h2>Ways to Support</h2>
    <hr />
    <div class="support-options">
      <div class="support-option">
        <h3>Donate</h3>
        <p>Make a tax-deductible donation directly to the team.</p>
        <Link href={import.meta.env.DONATE_URL}>Donate <External /></Link>
      </div>
      <div class="support-option">
        <h3>Sponsor</h3>
        <p>Partner with us as a corporate or individual sponsor.</p>
        <Link href="/contact">Become a Sponsor <External /></Link>
      </div>
    </div>
    <h2>Corporate Sponsors</h2>
    <hr />
    <CorporateSponsors />
    <h2>Individual Sponsors</h2>
    <hr />
    <ul class="individual-sponsors">
      {individualSponsors.map(sponsor => <li>{sponsor.attributes.name}</li>)}
    </ul>
    {
      packetUrl && (
        <div class="cta-row">
          <a class="cta-button" href={packetUrl} download>
            <i class="fa-solid fa-file-arrow-down" /> Download Sponsorship Packet
          </a>
        </div>
      )
    }
  </div>
</Layout>
<style>
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 32px;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  hr {
    border: 2px solid var(--accent);
    max-width: 100px;
    margin-left: 0;
    margin-bottom: 20px;
  }

  .individual-sponsors {
    font-size: 20px;
  }

  .support-options {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 24px;
    margin-bottom: 32px;
  }

  .support-option {
    flex: 1;
    min-width: 240px;
    background-color: var(--secondary);
    border-radius: 10px;
    padding: 24px;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
  }

  .support-option h3 {
    margin: 0;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  .support-option p {
    color: lightgray;
    margin: 12px 0;
  }

  .cta-row {
    width: 100%;
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border: 2px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-weight: bold;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .cta-button:hover {
    background-color: var(--accent);
    color: var(--primary);
  }
</style>
