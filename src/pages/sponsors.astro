---
import CorporateSponsors from "../components/CorporateSponsors.astro";
import External from "../components/External.astro";
import Image from "../components/Image.astro";
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
import type { ApiIndividualSponsorIndividualSponsor } from "../lib/contentTypes";
import fetchApi from "../lib/strapi";

const individualSponsors = await fetchApi<ApiIndividualSponsorIndividualSponsor[]>({
  endpoint: "individual-sponsors", // the content type to fetch
  wrappedByKey: "data", // the key to unwrap the response
  query: { populate: "*" }
});
---

<Layout title="Sponsors">
  <div class="container">
    <h2>Corporate Sponsors</h2>
    <hr />
    <CorporateSponsors />
    <h2>Individual Sponsors</h2>
    <hr />
    <ul class="individual-sponsors">
      {individualSponsors.map(sponsor => <li>{sponsor.attributes.name}</li>)}
    </ul>
    <div class="become-sponsor">
      <Link href="/contact">Become a Sponsor <External /></Link>
    </div>
  </div>
</Layout>
<style>
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 32px;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 0px;
    font-family: "Space Mono", monospace;
    color: var(--accent);
  }

  hr {
    border: 2px solid var(--accent);
    max-width: 100px;
    margin-left: 0;
    margin-bottom: 20px;
  }

  .individual-sponsors {
    font-size: 20px;
  }

  .become-sponsor {
    width: 100%;
    font-size: 20px;
    font-weight: bold;
    text-align: center;
  }
</style>
