---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found | Radicubs">
  <div class="w-full pt-32 pb-24 px-6 md:px-16 lg:px-24 bg-[#101215] min-h-screen flex flex-col items-center justify-center text-center">
    <h1 class="text-6xl md:text-8xl font-mono font-bold text-[#5ddb27] mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-mono text-white mb-4">Page Not Found</h2>
    <p class="text-[#a9a9a9] max-w-md mb-8">
      The page you're looking for doesn't exist or isn't available yet.
    </p>
    <Button href="/">Return Home</Button>
  </div>
</BaseLayout>
