---

<Layout title="Not Found">
  <div class="container">
    <a href="/">
      <!-- <Image
        id="bobot"
        class="bobot"
        alt="bobot"
        src={home.attributes.bobot.data.attributes.url}
        width={355.77}
        height={400}
      /> -->
