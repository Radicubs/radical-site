  <style>
    .container {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      text-align: center;
      height: 100%;
    }

    .bobot {
      transition: transform 0.3s;
      cursor: pointer;
    }

    .bobot:hover {
      transform: scale(1.1);
    }

    h1 {
      font-size: 54px;
    }

    p {
      color: lightgray;
      font-size: 18px;
      font-family: "Space Mono", monospace;
      margin: 0;
    }
  </style>
